# Copia este archivo como .env.local para pruebas locales.
# En Vercel, configura estas variables en Settings → Environment Variables.

# Clave de API de Resend (https://resend.com). Sin ella, el formulario
# responde "no disponible" y no simula envíos.
RESEND_API_KEY=

# Buzón que recibe las solicitudes del formulario.
CONTACT_TO_EMAIL=contacto@latina768.com

# Remitente. Déjalo vacío para usar onboarding@resend.dev (sin cambios de DNS;
# solo entrega al correo dueño de la cuenta de Resend).
# Para usar p. ej. "Latina 768 <web@latina768.com>" hay que verificar el dominio
# en Resend (registros DNS en GoDaddy, solo con autorización).
CONTACT_FROM_EMAIL=
