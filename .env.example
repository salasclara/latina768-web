# Copia este archivo como .env.local para pruebas locales.
# En Vercel, configura estas variables en Settings → Environment Variables.

# Destino principal: URL del "Webhook de entrada" (Inbound Webhook) del workflow de GoHighLevel.
GHL_WEBHOOK_URL=

# Alternativa por correo con Resend (solo se usa si GHL_WEBHOOK_URL está vacío).
RESEND_API_KEY=
CONTACT_TO_EMAIL=contacto@latina768.com
CONTACT_FROM_EMAIL=
